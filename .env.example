# ============================================================
# Maison Velours — Ortam Degiskenleri (ORNEK DOSYA)
# Bu dosyayi .env olarak kopyalayin ve gercek degerlerle doldurun.
# .env dosyasi ASLA sunucudan disariya, sayfa kaynagina veya
# istemci tarafi JS'e gonderilmez — sadece sunucu tarafinda okunur.
# ============================================================

# Uygulama
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SITE_NAME="Maison Velours Nail Atelier"

# Veritabani — ISTEGE BAGLI.
# Bos birakirsaniz (varsayilan): proje kendi icinde gelen GOMULU SQLite
# veritabanini kullanir (data/maison-velours.sqlite). Hicbir kurulum,
# hesap acma veya baglanti dizesi GEREKMEZ — "npm start" calistirmaniz
# yeterlidir.
#
# Vercel gibi serverless bir ortamda kalici (persistent) veri istiyorsaniz
# (cunku serverless dosya sistemi kalici degildir), buraya bir PostgreSQL
# baglanti dizesi girin — Vercel Postgres / Neon / Supabase panelinden
# alabilirsiniz. Ornek:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Oturum / Token imzalama anahtarlari
# Uretmek icin: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_super_secret_session_key
JWT_2FA_PENDING_SECRET=CHANGE_ME_super_secret_pending_key
COOKIE_SECRET=CHANGE_ME_super_secret_cookie_key

# Admin hesabi ARTIK burada tanimlanmiyor.
# Ilk admin hesabinizi, siteyi calistirdiktan sonra tarayicidan
# /admin/setup adresine giderek olusturursunuz (kullanici adi, sifre
# ve 2FA QR kodu tek akista kurulur — CLI komutu gerekmez).
