<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= settings.businessName %> — Manikür, Pedikür & Nail Art | Nişantaşı</title>
<meta name="description" content="<%= settings.metaDescription %>">
<meta name="keywords" content="<%= settings.metaKeywords %>">
<meta name="robots" content="index, follow">
<link rel="canonical" href="<%= url %>">

<meta property="og:type" content="business.business">
<meta property="og:title" content="<%= settings.businessName %>">
<meta property="og:description" content="<%= settings.metaDescription %>">
<meta property="og:url" content="<%= url %>">
<% if (services[0] && services[0].image) { %><meta property="og:image" content="<%= services[0].image %>"><% } %>
<meta property="og:locale" content="tr_TR">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">

<!-- schema.org: BeautySalon (veritabanindan otomatik uretilir) -->
<script type="application/ld+json"><%- schemaJson %></script>
</head>
<body>

<header>
  <div class="nav">
    <div class="logo">Maison <em>Velours</em></div>
    <nav class="navlinks" id="navlinks">
      <a href="#hizmetler">Hizmetler</a>
      <a href="#hakkimizda">Hakkımızda</a>
      <a href="#galeri">Galeri</a>
      <a href="#yorumlar">Salon Yorumları</a>
      <a href="#iletisim">İletişim</a>
    </nav>
    <div class="navcta">
      <button class="menu-toggle" id="menuToggle" aria-label="Menü">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <div class="hero-eyebrow">Nişantaşı, İstanbul</div>
        <h1><%= settings.tagline %></h1>
        <p class="hero-sub"><%= settings.heroSubtext %></p>
        <div class="hero-actions">
          <a class="btn btn-gold" href="https://wa.me/<%= settings.whatsapp %>">Randevu Al</a>
          <a class="btn btn-line-dark" href="#hizmetler">Hizmetleri Keşfet</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="frame">
          <% var heroImg = settings.heroImage || (services[0] && services[0].image); %>
          <% if (heroImg) { %>
          <img src="<%= heroImg %>" alt="<%= settings.businessName %>" loading="eager">
          <% } %>
        </div>
        <div class="hero-badge">
          <div class="b-label">Bu ay</div>
          <div class="b-main">Kampanyalı Fiyatlar</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ticker">
    <div class="ticker-track">
      <% for (let r = 0; r < 3; r++) { %>
        <% services.forEach(function(s){ %><span><%= s.name %></span><% }) %>
      <% } %>
    </div>
  </div>
</section>

<section class="services on-dark" id="hizmetler">
  <div class="wrap">
    <div class="section-head">
      <h2>Hizmetlerimiz</h2>
      <p>Her işlem tıbbi sterilizasyondan geçmiş aletlerle, uzman ellerimizde uygulanır. Bu ayın kampanyalı fiyatları aşağıda.</p>
    </div>
    <div class="service-list">
      <% services.forEach(function(s){ %>
      <div class="service-row">
        <div class="service-thumb"><img src="<%= s.image %>" alt="<%= s.name %> işlemi" loading="lazy"></div>
        <div class="service-info">
          <h3><%= s.name %></h3>
          <p><%= s.description %></p>
          <div class="service-duration"><%= s.duration %></div>
        </div>
        <div class="service-price">
          <% if (s.oldPrice) { %><span class="price-old"><%= s.oldPrice %></span><% } %>
          <span class="price-new"><%= s.newPrice %></span>
          <span class="price-tag"><%= s.priceTag %></span>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="about on-light" id="hakkimizda">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-media">
        <% var aboutImg = settings.aboutImage || (services[2] && services[2].image); %>
        <% if (aboutImg) { %><img src="<%= aboutImg %>" alt="<%= settings.aboutTitle %>" loading="lazy"><% } %>
      </div>
      <div class="about-text">
        <h2><%= settings.aboutTitle %></h2>
        <p><%= settings.aboutParagraph1 %></p>
        <p style="margin-top:18px;"><%= settings.aboutParagraph2 %></p>
        <div class="about-stats">
          <div><div class="num"><%= settings.stat1Num %></div><div class="lbl"><%= settings.stat1Label %></div></div>
          <div><div class="num"><%= settings.stat2Num %></div><div class="lbl"><%= settings.stat2Label %></div></div>
          <div><div class="num"><%= settings.stat3Num %></div><div class="lbl"><%= settings.stat3Label %></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="gallery" id="galeri">
  <div class="wrap">
    <div class="section-head on-light">
      <h2>Galeri</h2>
      <p>Atölyemizden çıkan işlerden bir kesit — her tasarım, müşterimizin zevkine göre elde çizilir.</p>
    </div>
  </div>
  <div class="marquee-row row-a">
    <div class="marquee-track">
      <% for (let r = 0; r < 2; r++) { %>
        <% gallery.rowA.forEach(function(g){ %><img src="<%= g.imageUrl %>" alt="<%= g.alt %>" loading="lazy"><% }) %>
      <% } %>
    </div>
  </div>
  <div class="marquee-row row-b">
    <div class="marquee-track">
      <% for (let r = 0; r < 2; r++) { %>
        <% gallery.rowB.forEach(function(g){ %><img src="<%= g.imageUrl %>" alt="<%= g.alt %>" loading="lazy"><% }) %>
      <% } %>
    </div>
  </div>
</section>

<section class="reviews" id="yorumlar">
  <div class="wrap">
    <div class="section-head on-dark">
      <h2>Salon yorumları</h2>
      <p>
        Koltuğumuza oturan müşterilerimizin bize bıraktığı notlardan birkaçı
        <% if (aggregate.reviewCount > 0) { %> — ortalama <strong><%= aggregate.ratingValue %>/5</strong> (<%= aggregate.reviewCount %> değerlendirme)<% } %>.
      </p>
    </div>
  </div>
  <div class="review-marquee">
    <div class="review-track">
      <% for (let r = 0; r < 2; r++) { %>
        <% reviews.forEach(function(rv){ %>
        <div class="review-card">
          <span class="review-quote">"</span>
          <div class="review-stars"><%= '★'.repeat(rv.rating) + '☆'.repeat(5 - rv.rating) %></div>
          <p class="review-text"><%= rv.text %></p>
          <div class="review-name"><%= rv.name %></div>
          <% if (rv.tag) { %><div class="review-tag"><%= rv.tag %></div><% } %>
        </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>

<section class="contact on-light" id="iletisim">
  <div class="wrap">
    <div class="section-head" style="margin-bottom:0;">
      <h2>İletişim</h2>
      <p>Randevu almak veya sorularınız için bize ulaşın, size en yakın zamanda dönüş yapalım.</p>
    </div>
    <div class="contact-grid">
      <div>
        <div class="contact-list">
          <div class="contact-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A1024" stroke-width="1.6"><path d="M12 21s7-6.1 7-11.5A7 7 0 1 0 5 9.5C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.4"/></svg>
            <div><div class="c-label">Adres</div><div class="c-val"><%= settings.address %></div></div>
          </div>
          <div class="contact-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A1024" stroke-width="1.6"><path d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.6 21 3 14.4 3 6a2 2 0 0 1 1-2z"/></svg>
            <div><div class="c-label">Telefon</div><div class="c-val"><%= settings.phone %></div></div>
          </div>
          <div class="contact-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A1024" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <div><div class="c-label">E-posta</div><div class="c-val"><%= settings.email %></div></div>
          </div>
        </div>
        <div class="social-row">
          <a href="<%= settings.instagram %>" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="<%= settings.tiktok %>" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 4v9.6a3.6 3.6 0 1 1-3-3.55"/><path d="M14 4c.5 2.6 2.2 4.2 5 4.5"/></svg>
          </a>
          <a href="<%= settings.facebook %>" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 8h-2a2 2 0 0 0-2 2v10M9 13h4"/><circle cx="12" cy="12" r="9"/></svg>
          </a>
          <a href="https://wa.me/<%= settings.whatsapp %>" aria-label="WhatsApp" target="_blank" rel="noopener">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.7 19L4 20z"/><path d="M8.5 9.5c.3 2.6 2.4 4.7 5 5"/></svg>
          </a>
        </div>
        <div class="hours-box">
          <% settings.hours.forEach(function(h){ %>
          <div class="hours-row"><span><%= h.day %></span><span><%= h.value %></span></div>
          <% }) %>
        </div>
      </div>

      <div class="contact-map">
        <iframe
          title="Salon konumu haritası"
          src="https://maps.google.com/maps?q=<%= encodeURIComponent(settings.address) %>&z=15&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-logo">Maison <em>Velours</em></div>
        <p class="foot-tag"><%= settings.footerTagline %></p>
      </div>
      <div class="foot-links">
        <div class="foot-col">
          <h4>Sayfalar</h4>
          <a href="#hizmetler">Hizmetler</a>
          <a href="#hakkimizda">Hakkımızda</a>
          <a href="#galeri">Galeri</a>
          <a href="#yorumlar">Salon Yorumları</a>
        </div>
        <div class="foot-col">
          <h4>İletişim</h4>
          <p><%= settings.address %></p>
          <p><%= settings.phone %></p>
          <p><%= settings.email %></p>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© <%= new Date().getFullYear() %> <%= settings.businessName %>. Tüm hakları saklıdır.</span>
      <div class="foot-social">
        <a href="<%= settings.instagram %>" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
        </a>
        <a href="<%= settings.tiktok %>" aria-label="TikTok" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 4v9.6a3.6 3.6 0 1 1-3-3.55"/><path d="M14 4c.5 2.6 2.2 4.2 5 4.5"/></svg>
        </a>
        <a href="https://wa.me/<%= settings.whatsapp %>" aria-label="WhatsApp" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.7 19L4 20z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script src="/js/site.js"></script>
</body>
</html>
